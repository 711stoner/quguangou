{
  "manifest_version": 3,
  "name": "__MSG_extensionNameChrome__",
  "version": "0.2.20",
  "description": "__MSG_extensionDescriptionChrome__",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://711stoner.github.io/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "short_name": "__MSG_extensionShortName__",
  "default_locale": "zh_CN"
}
