{
  "manifest_version": 3,
  "name": "取关狗",
  "version": "0.2.8",
  "description": "查看经用户提交证据形成的 X 单方面取关名单，并在确认后依次拉黑。",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://x.com/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "取关狗",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  }
}
